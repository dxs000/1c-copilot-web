[Unit]
Description=1С Project Copilot — веб-интерфейс (порт 80)
Documentation=file:///opt/1c-copilot-web/deploy/README.md
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=copilot
Group=copilot
# Настройки ядра читаются из /opt/1c-copilot-web/.env (рабочий каталог)
WorkingDirectory=/opt/1c-copilot-web
ExecStart=/opt/1c-copilot-web/.venv/bin/copilot1c-web --host 0.0.0.0 --port 80
Restart=on-failure
RestartSec=5

# Порт 80 без root: только право занимать привилегированные порты
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Ограничения: писать можно только в кэш и папку материалов
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/1c-copilot-web/.cache /opt/1c-copilot-web/data

[Install]
WantedBy=multi-user.target
